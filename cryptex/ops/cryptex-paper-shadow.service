[Unit]
Description=CRYPTEX separate PAPER_ONLY shadow engine (NEVER publishes paper journal)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=true
StateDirectory=cryptex-paper-shadow
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/cryptex-server-kit/cryptex/ops/server_shadow.py
WorkingDirectory=/var/lib/cryptex-paper-shadow
TimeoutStartSec=240
CPUQuota=50%
Nice=15
IOSchedulingClass=idle
MemoryHigh=640M
MemoryMax=900M
TasksMax=70
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/cryptex-paper-shadow
# Never access the private network used by unrelated services/CSGORisky.
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16

[Install]
WantedBy=multi-user.target
