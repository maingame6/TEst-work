[Unit]
Description=CRYPTEX independent VPS paper-only heartbeat / GitHub recovery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryptex-heartbeat
Group=cryptex-heartbeat
EnvironmentFile=/etc/cryptex/monitor.env
ExecStart=/usr/local/bin/cryptex-server-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cryptex-heartbeat /srv/cryptex/TEst-work
TimeoutStartSec=160
